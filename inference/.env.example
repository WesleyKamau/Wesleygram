# Cloudflare R2 credentials for the inference pipeline.
# Copy to inference/.env and fill in real values. (.env is gitignored — NEVER commit real keys.)
#
# The inference notebook reads the long *_URL / *_ID / *_ACCESS_KEY names first and
# falls back to the short names, so either convention works. Standardize on these:

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=images-original

# Short-name fallbacks (used only if the long names above are unset):
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=images-original
